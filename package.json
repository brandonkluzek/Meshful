{
  "name": "meshful",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "check": "node scripts/verify-release.mjs",
    "test": "cd site && node --test tests/*.test.mjs",
    "verify:webmcp": "cd site && node --test tests/webmcp-metadata.test.mjs tests/continuous-study.test.mjs",
    "build": "npm --prefix site run build",
    "verify": "npm run check && npm test && npm run verify:webmcp && npm run build"
  }
}
